modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

# Secrets must live in Replit Secrets / EAS environment variables.
# Never commit tokens, service keys, or private client secrets.
[userenv]

[userenv.production]
FIREBASE_PROJECT_ID = "oldtime-a23af"
SUPABASE_URL = "https://kcwawiqtfmravkljfswu.supabase.co"

[nix]
channel = "stable-25_05"

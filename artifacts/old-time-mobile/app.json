{
  "expo": {
    "name": "Old Time",
    "slug": "oldtimeuniversal",
    "owner": "oldtimes-team",
    "version": "1.0.1",
    "description": "Old Time is a private messenger for chats, updates, calls, and shared moments.",
    "orientation": "portrait",
    "icon": "./assets/images/old-time-feather-logo.png",
    "scheme": "old-time-mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/old-time-native-splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#D71920"
    },
    "ios": {
      "supportsTablet": false,
      "buildNumber": "80",
      "bundleIdentifier": "com.oldtime.messenger",
      "appleTeamId": "FC6ZRKNS2N",
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.oldtime.messenger"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "RTCAppGroupIdentifier": "group.com.oldtime.messenger",
        "RTCScreenSharingExtension": "com.oldtime.messenger.broadcast",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.226926464189-b0sssaitabuo5ejna8ibd6lghbub6vo0"
            ]
          }
        ],
        "NSMicrophoneUsageDescription": "Old Time uses your microphone for voice notes and calls.",
        "NSCameraUsageDescription": "Old Time uses your camera to share photos, video, and your status.",
        "NSPhotoLibraryUsageDescription": "Old Time uses your photo library to share images in chats.",
        "NSContactsUsageDescription": "Old Time uses your contacts to help you find friends who already use the app.",
        "NSLocationWhenInUseUsageDescription": "Old Time uses your location to suggest nearby routes and record a Pace route only when you choose to start tracking.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Old Time uses your location in the background only while you are actively recording a Pace route."
      }
    },
    "android": {
      "package": "com.oldtime.messenger",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/old-time-feather-logo.png",
        "backgroundColor": "#D71920"
      }
    },
    "web": {
      "favicon": "./assets/images/old-time-feather-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Old Time to access your camera to capture moments for your story.",
          "microphonePermission": "Allow Old Time to access your microphone to record audio with your videos."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Old Time to access your microphone for voice notes and calls."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Old Time to access your photos to share them with your friends."
        }
      ],
      "expo-contacts",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Old Time to record your Pace route when the screen is locked, only while you are actively tracking."
        }
      ],
      "expo-notifications",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication",
            "enableScreenShareService": true
          }
        }
      ],
      "@config-plugins/react-native-webrtc",
      "@bacons/apple-targets",
      "expo-video",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.oldtime.messenger"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-7063228070009280~4198410047",
          "delayAppMeasurementInit": true,
          "userTrackingUsageDescription": "Old Time may use this device identifier to measure and improve advertising.",
          "optimizeInitialization": true,
          "optimizeAdLoading": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "apiDomain": "old-time-messenger--kingvercetti59.replit.app",
      "releaseCommit": "f5ded3c98bf6a2f7df384b454d7c967693da74bf",
      "eas": {
        "projectId": "4cdaddfe-a954-4270-ba26-f6a405e2f9e5"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4cdaddfe-a954-4270-ba26-f6a405e2f9e5"
    }
  }
}
